# =====================================================================
#  Variables de entorno — setear en Vercel (Project Settings → Environment Variables).
#  NUNCA commitear el .env real. Esto es solo plantilla.
# =====================================================================

# --- Mercado Pago ---
# Sandbox (TEST) para desarrollo / Producción (APP_USR...) para cobrar de verdad.
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000
# Secreto de la firma del webhook (MP → Tus integraciones → Webhooks → clave secreta).
MP_WEBHOOK_SECRET=

# --- WhatsApp al primo (elegí UN canal) ---
# Número del primo: país+área+nro, sin "+", sin "15". Ej Mendoza: 5492610000000
PRIMO_WA=

# Opción A — CallMeBot (atajo, cero setup):
CALLMEBOT_KEY=

# Opción B — WhatsApp Cloud API (oficial, Meta):
# WA_TOKEN=
# WA_PHONE_ID=
